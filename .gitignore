.env
/vendor/
/storage/logs/*
!/storage/logs/.gitkeep
/storage/applications/*
!/storage/applications/.gitkeep
!/storage/applications/.htaccess
/storage/cache/*
!/storage/cache/.gitkeep
/storage/integrity-baseline.json
/storage/integrity-baseline.json.*.tmp
/storage/integrity-baseline.json.*.bak
/storage/sessions/*
!/storage/sessions/.gitkeep
/public/uploads/*
!/public/uploads/.htaccess
!/public/uploads/.gitkeep
/node_modules/
/.idea/
/.vscode/
*.log
/docs
!/docs/
!/docs/RWD.md
