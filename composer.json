{
    "name": "pfp/papua-future-project",
    "description": "Website Papua Future Project dengan PHP native MVC",
    "type": "project",
    "require": {
        "php": ">=8.4",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-zip": "*",
        "dompdf/dompdf": "^3.1",
        "phpoffice/phpspreadsheet": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": ["app/Core/helpers.php"]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
